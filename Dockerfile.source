FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY go.sum ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go test ./... \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ai-route ./cmd/ai-route

FROM alpine:3
RUN apk add --no-cache ca-certificates
COPY --from=build /out/ai-route /usr/bin/ai-route
ENTRYPOINT ["/usr/bin/ai-route"]
